# Public values from Supabase Project Settings > API.
# Replace with your actual project values; leave unset to keep setup mode.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# Never use service-role or secret keys in VITE_ variables.

# Optional local API override if port 3001 is occupied (not bundled into the client).
# API_PROXY_TARGET=http://127.0.0.1:3002
